BUILD_DIR := build
HOST_BUILD_DIR := $(BUILD_DIR)/host
HOST_OBJ_DIR := $(HOST_BUILD_DIR)/obj
HOST_BIN_DIR := $(HOST_BUILD_DIR)/bin
HOST_TEST_OBJ_DIR := $(HOST_BUILD_DIR)/tests/obj
HOST_TEST_BIN_DIR := $(HOST_BUILD_DIR)/tests/bin
PROGRAM_BUILD_DIR := $(BUILD_DIR)/toolchains/$(BUILD_TOOLCHAIN)
PROGRAM_OBJ_DIR := $(PROGRAM_BUILD_DIR)/obj
PROGRAM_BIN_DIR := $(PROGRAM_BUILD_DIR)/bin
FISICS_TOOLCHAIN_DIR := $(BUILD_DIR)/toolchains/fisics
LINE_DRAWING_UNITS_SEMA_OUTPUT := $(FISICS_TOOLCHAIN_DIR)/canonical_scene_export.sema.txt
LINE_DRAWING_UNITS_PRIMITIVES_SEMA_OUTPUT := $(FISICS_TOOLCHAIN_DIR)/canonical_scene_export_primitives.sema.txt
LINE_DRAWING_UNITS_IMPORT_SEMA_OUTPUT := $(FISICS_TOOLCHAIN_DIR)/scene_import.sema.txt

APP_TARGET := $(PROGRAM_BIN_DIR)/LineDrawing
TEST_TARGET := $(HOST_TEST_BIN_DIR)/run_tests
FOLDER_PICKER_TEST_BIN := $(HOST_TEST_BIN_DIR)/line_drawing_folder_picker_test
PACKAGE_SOURCE_BIN := $(call program_bin_for,$(PACKAGE_TOOLCHAIN))
DIST_DIR := dist

PACKAGE_APP_DIR := $(DIST_DIR)/$(PACKAGE_APP_NAME)
PACKAGE_CONTENTS_DIR := $(PACKAGE_APP_DIR)/Contents
PACKAGE_MACOS_DIR := $(PACKAGE_CONTENTS_DIR)/MacOS
PACKAGE_RESOURCES_DIR := $(PACKAGE_CONTENTS_DIR)/Resources
PACKAGE_FRAMEWORKS_DIR := $(PACKAGE_CONTENTS_DIR)/Frameworks
PACKAGE_INFO_PLIST_SRC := tools/packaging/macos/Info.plist
PACKAGE_LAUNCHER_SCRIPT_SRC := tools/packaging/macos/line-drawing-launcher
PACKAGE_LAUNCHER_NATIVE_SRC := tools/packaging/macos/line-drawing-launcher.c
PACKAGE_LAUNCHER_SCRIPT_PATH := $(PACKAGE_RESOURCES_DIR)/line-drawing-launcher.sh
PACKAGE_RELEASE_ZIP_VERIFIER := tools/packaging/macos/verify-release-zip.sh
PACKAGE_DYLIB_BUNDLER := tools/packaging/macos/bundle-dylibs.sh
PACKAGE_LOCAL_ICON_DIR := tools/packaging/macos/local_app_icon
PACKAGE_APP_ICON_SRC ?= $(PACKAGE_LOCAL_ICON_DIR)/$(PACKAGE_APP_ICON_FILE)
PACKAGE_APP_ICONSET_SRC ?= $(PACKAGE_LOCAL_ICON_DIR)/$(PACKAGE_APP_ICON_NAME).iconset
PACKAGE_BUNDLED_ICON_PATH := $(PACKAGE_RESOURCES_DIR)/$(PACKAGE_APP_ICON_FILE)
DESKTOP_APP_DIR ?= $(HOME)/Desktop/$(PACKAGE_APP_NAME)

RELEASE_ARTIFACT_BASENAME := $(RELEASE_PRODUCT_NAME)-$(RELEASE_VERSION)-$(RELEASE_PLATFORM)-$(RELEASE_ARCH)-$(RELEASE_CHANNEL)
RELEASE_DIR := build/release
RELEASE_SOURCE_COMMIT := $(shell git rev-parse HEAD 2>/dev/null)
RELEASE_APP_ZIP := $(RELEASE_DIR)/$(RELEASE_ARTIFACT_BASENAME).zip
RELEASE_NOTARY_ZIP := $(RELEASE_DIR)/$(RELEASE_ARTIFACT_BASENAME)-notary-submit.zip
RELEASE_MANIFEST := $(RELEASE_DIR)/$(RELEASE_ARTIFACT_BASENAME).manifest.txt
RELEASE_ROUNDTRIP_RECEIPT := $(RELEASE_DIR)/$(RELEASE_ARTIFACT_BASENAME).roundtrip.json

SHAPE_SANITY_BIN := $(PROGRAM_BIN_DIR)/shape_sanity_tool
SHAPE_PACK_TOOL_BIN := $(PROGRAM_BIN_DIR)/shape_pack_tool
SHAPE_TRACE_TOOL_BIN := $(PROGRAM_BIN_DIR)/shape_trace_tool
SHAPE_TOOL_BIN := $(PROGRAM_BIN_DIR)/shape_tool
AGENT_SCENE_TOOL_BIN := $(PROGRAM_BIN_DIR)/agent_scene_tool
IMPORTED_MESH_HARNESS_BIN := $(PROGRAM_BIN_DIR)/imported_mesh_harness
